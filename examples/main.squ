{
    println("Simple Calculator")
    println("1. Add")
    println("2. Subtract")
    println("3. Multiply")
    println("4. Divide")
    choice = input("Enter choice (1-4): ")
    a = real(input("Enter first number: "))
    b = real(input("Enter second number: "))
    result = 0.0
    operation = "";

    if (choice == "1") {
        result = a + b
        operation = "+"
    } else if (choice == "2") {
        result = a - b
        operation = "-"
    } else if (choice == "3") {
        result = a * b
        operation = "*"
    } else if (choice == "4") {
        if (b == 0) {
            println("Error: Division by zero!")
            return
        }
        result = a / b
        operation = "/"
    } else {
        println("Invalid choice!")
        return
    }
    println(str(a), operation, str(b), "=", str(result))
}